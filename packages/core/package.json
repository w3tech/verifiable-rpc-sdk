{
  "name": "@w3tech.io/vrpc-core",
  "version": "0.4.0",
  "type": "module",
  "description": "Transport-agnostic Ed25519 verification primitives for Ankr's verifiable RPC — pre-image, signature verify, attestation.",
  "license": "Apache-2.0",
  "author": "Web3 Technologies, Inc.",
  "homepage": "https://github.com/w3tech/verifiable-rpc-sdk#readme",
  "bugs": "https://github.com/w3tech/verifiable-rpc-sdk/issues",
  "keywords": [
    "ethereum",
    "rpc",
    "verifiable",
    "attestation",
    "tdx",
    "ed25519",
    "json-rpc"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3tech/verifiable-rpc-sdk.git",
    "directory": "packages/core"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./dist/errors.js",
      "default": "./dist/errors.js"
    },
    "./confidential": {
      "types": "./src/confidential.ts",
      "import": "./dist/confidential.js",
      "default": "./dist/confidential.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES"
  ],
  "sideEffects": false,
  "browser": {
    "crypto": false
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./errors": {
        "types": "./dist/errors.d.ts",
        "import": "./dist/errors.js",
        "default": "./dist/errors.js"
      },
      "./confidential": {
        "types": "./dist/confidential.d.ts",
        "import": "./dist/confidential.js",
        "default": "./dist/confidential.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run tests --exclude 'tests/integration/**'",
    "test:integration": "vitest run tests/integration",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "dependencies": {
    "@w3tech.io/dstack-verify": "workspace:*",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "2.4.0",
    "lru-cache": "^11.5.3"
  },
  "devDependencies": {
    "@hpke/core": "1.9.0",
    "@hpke/dhkem-x25519": "1.8.0",
    "@noble/curves": "2.4.0",
    "@types/node": "^22.16.0",
    "@w3tech.io/vrpc-test-support": "workspace:*",
    "bhttp-ts": "0.6.1"
  }
}
